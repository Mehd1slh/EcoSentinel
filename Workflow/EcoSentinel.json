    {
      "parameters": {
        "jsCode": "const sensorMap = {\n  9255955: \"pm1\",\n  9255937: \"pm10\",\n  9255953: \"pm25\",\n  9255958: \"humidity\",\n  9255938: \"temperature\",\n  9255960: \"pm0.3\"\n};\n\nconst rawResults = $json.results;\nconst output = rawResults.map(item => {\n  const id = item.sensorsId;\n  return {\n    json: {\n      sensorId: id,\n      parameter: sensorMap[id] || `sensor_${id}`,\n      value: item.value,\n      timestamp: item.datetime.utc,\n      locationId: item.locationsId,\n      coordinates: item.coordinates\n    }\n  };\n});\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        100
      ],
      "id": "c1bcc246-e021-4a7f-81f5-f0ab488f7a40",
      "name": "extract data",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const data3h = $json[\"data_3h\"];\nconst metadata = $json[\"metadata\"];\nconst index = 0;\n\n// Extract all relevant variables first\nconst pm10 = data3h.pm10[index];\nconst pm25 = data3h.pm25[index];\nconst airqualityindex = data3h.airqualityindex[index];\nconst humidity = data3h.relativehumidity[index];\nconst precipitation = data3h.precipitation[index];\nconst soil_moisture = data3h.soilmoisture_0to10cm[index];\n\n// Build full output object\nconst output = {\n  timestamp: new Date().toISOString(),\n\n  // General Weather & Location\n  temperature: data3h.temperature[index],\n  humidity,\n  windspeed: data3h.windspeed[index],\n  winddirection: data3h.winddirection[index],\n  airqualityindex,\n  location: {\n    latitude: metadata.latitude,\n    longitude: metadata.longitude,\n    timezone: metadata.timezone_abbrevation\n  },\n\n  // Air Pollution\n  pm10,\n  pm25,\n  ozone: data3h.ozone[index],\n  no2: data3h.no2[index],\n  co: data3h.co[index],\n  so2: data3h.so2[index],\n  dust_concentration: data3h.dust_concentration[index],\n  aod550: data3h.aod550[index],\n\n  // Water & Soil\n  precipitation,\n  precipitation_probability: data3h.precipitation_probability[index],\n  soil_moisture,\n  evapotranspiration: data3h.evapotranspiration[index],\n  reference_et0: data3h.referenceevapotranspiration_fao[index],\n\n  // Solar & Energy\n  ghi: data3h.ghi_total[index],\n  dni: data3h.dni_total[index],\n  wind_gust: data3h.gust[index],\n  air_density: data3h.airdensity[index],\n\n  // 🚨 Smart Alert\n  alert: (\n    pm10 > 50 ||\n    pm25 > 25 ||\n    (airqualityindex > 75 && humidity < 30) || // health alert\n    (precipitation > 10 && soil_moisture > 80) // overflow risk\n  )\n};\n\nreturn [{ json: output }];\n"
      },
