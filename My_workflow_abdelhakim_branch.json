    {
      "parameters": {
        "method": "POST",
        "url": "https://services.sentinel-hub.com/api/v1/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer  {{ $json.access_token }}"
            },
            {
              "name": "Accept",
              "value": "image/jpeg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": {\n    \"bounds\": {\n      \"properties\": {\n        \"crs\": \"http://www.opengis.net/def/crs/OGC/1.3/CRS84\"\n      },\n      \"bbox\": [\n        {{ $json.bbox }}\n      ]\n    },\n    \"data\": [\n      {\n        \"type\": \"sentinel-2-l2a\",\n        \"dataFilter\": {\n          \"timeRange\": {\n            \"from\": \"2025-05-20T00:00:00Z\",\n            \"to\": \"2025-05-26T23:59:59Z\"\n          },\n          \"maxCloudCoverage\": 50,\n          \"mosaicOrder\": \"leastCC\"\n        }\n      }\n    ]\n  },\n  \"output\": {\n    \"width\": 512,\n    \"height\": 512,\n    \"responses\": [\n      {\n        \"identifier\": \"default\",\n        \"format\": {\n          \"type\": \"image/tiff\"\n        }\n      }\n    ]\n  },\n  \"evalscript\": \"//VERSION=3\\nfunction setup() {\\n  return {\\n    input: [\\\"B04\\\", \\\"B08\\\"],\\n    output: { bands: 3 }\\n  };\\n}\\nfunction evaluatePixel(sample) {\\n  let ndvi = (sample.B08 - sample.B04) / (sample.B08 + sample.B04);\\n  if (ndvi < 0.1) return [1, 0, 0]; // red = bad for solar\\n  else if (ndvi < 0.3) return [1, 1, 0]; // yellow = moderate\\n  else return [0, 1, 0]; // green = good solar potential\\n}\"\n}\n",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
