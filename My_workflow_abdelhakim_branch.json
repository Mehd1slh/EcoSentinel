        "jsonBody": "={\n  \"input\": {\n    \"bounds\": {\n      \"bbox\": [\n        {{ $json[\"bbox\"][0] }},\n        {{ $json[\"bbox\"][1] }},\n        {{ $json[\"bbox\"][2] }},\n        {{ $json[\"bbox\"][3] }}\n      ],\n      \"properties\": {\n        \"crs\": \"http://www.opengis.net/def/crs/OGC/1.3/CRS84\"\n      }\n    },\n    \"data\": [\n      {\n        \"type\": \"sentinel-2-l2a\",\n        \"dataFilter\": {\n          \"timeRange\": {\n            \"from\": \"2025-05-20T00:00:00Z\",\n            \"to\": \"2025-05-26T23:59:59Z\"\n          },\n          \"layer\": \"TRUE_COLOR\"\n        }\n      }\n    ]\n  },\n  \"output\": {\n    \"width\": 256,\n    \"height\": 256,\n    \"responses\": [\n      {\n        \"identifier\": \"default\",\n        \"format\": {\n          \"type\": \"image/jpeg\"\n        }\n      }\n    ]\n  }\n}\n",
